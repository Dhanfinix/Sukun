<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="6dp">

    <TextView
        android:id="@+id/prayer_widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="2dp"
        android:text="Sukun"
        android:textColor="#6B5042"
        android:textSize="9sp"
        android:textStyle="bold" />

    <!-- Prayers Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Fajr -->
        <LinearLayout
            android:id="@+id/slot_fajr"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">
            <TextView
                android:id="@+id/fajr_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prayer_fajr"
                android:textColor="#6B5042"
                android:textSize="9sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/fajr_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="--:--"
                android:textColor="#1C1611"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dhuhr -->
        <LinearLayout
            android:id="@+id/slot_dhuhr"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">
            <TextView
                android:id="@+id/dhuhr_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prayer_dhuhr"
                android:textColor="#6B5042"
                android:textSize="9sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/dhuhr_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="--:--"
                android:textColor="#1C1611"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Asr -->
        <LinearLayout
            android:id="@+id/slot_asr"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">
            <TextView
                android:id="@+id/asr_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prayer_asr"
                android:textColor="#6B5042"
                android:textSize="9sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/asr_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="--:--"
                android:textColor="#1C1611"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Maghrib -->
        <LinearLayout
            android:id="@+id/slot_maghrib"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">
            <TextView
                android:id="@+id/maghrib_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prayer_maghrib"
                android:textColor="#6B5042"
                android:textSize="9sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/maghrib_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="--:--"
                android:textColor="#1C1611"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Isha -->
        <LinearLayout
            android:id="@+id/slot_isha"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">
            <TextView
                android:id="@+id/isha_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prayer_isha"
                android:textColor="#6B5042"
                android:textSize="9sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/isha_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="--:--"
                android:textColor="#1C1611"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Footer Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">
        <TextView
            android:id="@+id/prayer_widget_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="Jakarta"
            android:textColor="#7D7063"
            android:textSize="8sp" />
        <TextView
            android:id="@+id/prayer_widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="20 April 2026"
            android:textColor="#7D7063"
            android:textSize="8sp" />
    </RelativeLayout>

</LinearLayout>
