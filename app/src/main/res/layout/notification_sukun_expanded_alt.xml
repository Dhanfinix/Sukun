<?xml version="1.0" encoding="utf-8"?>
<!--
    Alternate copy of notification_sukun_expanded.
    SystemUI can cache an already-expanded custom notification view; alternating
    layout ids forces a clean re-bind so progress changes are visible in-place.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/notif_expanded_prayer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fajr"
                android:textAppearance="@style/TextAppearance.Compat.Notification.Line2"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" · "
                android:textAppearance="@style/TextAppearance.Compat.Notification.Line2" />

            <TextView
                android:id="@+id/notif_expanded_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Compat.Notification.Line2"
                android:maxLines="1" />

        </LinearLayout>

        <Chronometer
            android:id="@+id/notif_expanded_chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:countDown="true"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:textSize="36sp" />

        <ProgressBar
            android:id="@+id/notif_expanded_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="12dp"
            android:indeterminate="false"
            android:max="1000"
            android:progressDrawable="@drawable/bg_notification_progress" />

        <TextView
            android:id="@+id/notif_expanded_end_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Ends at 14:53"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Line2"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="8dp">

        <TextView
            android:id="@+id/notif_expanded_extend"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="12dp"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="+5m"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Line2"
            android:textColor="@color/sukun_primary"
            android:textStyle="bold"
            android:background="@drawable/bg_extend_pill"
            android:contentDescription="@string/extend_silence" />

        <ImageView
            android:id="@+id/notif_expanded_stop"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_stop"
            android:tint="@color/sukun_error"
            android:background="@drawable/bg_stop_tonal_circle"
            android:padding="14dp"
            android:contentDescription="@string/stop_silence"
            android:scaleType="fitCenter" />

    </LinearLayout>

</LinearLayout>
